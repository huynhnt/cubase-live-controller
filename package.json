{
  "name": "cubase-live-controller",
  "version": "1.0.0",
  "description": "Overlay control panel for Cubase using Web MIDI API",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "build": "vite build",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.cubaselivecontroller.app",
    "productName": "Cubase Live Controller",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
